{
  "name": "game-factory",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools playwright.config.ts eslint.config.js",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "check:artifact": "node tools/check-artifact.mjs",
    "check:w2-core-churn": "node tools/check-w2-core-churn.mjs",
    "check:w3-core-churn": "node tools/check-w3-core-churn.mjs",
    "check:w5-extraction": "node tools/check-w5-extraction.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:create-game && npm run build && npm run check:artifact && npm run test:e2e",
    "hunt": "node tools/skeleton-hunt/index.mjs",
    "hunt:check": "node --check tools/skeleton-hunt/index.mjs",
    "create-game": "node tools/create-game.mjs",
    "test:create-game": "node tools/test-create-game.mjs"
  },
  "dependencies": {
    "littlejsengine": "1.25.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
