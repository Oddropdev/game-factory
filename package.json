{
  "name": "game-factory",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools playwright.config.ts eslint.config.js",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "check:artifact": "node tools/check-artifact.mjs",
    "check:w2-core-churn": "node tools/check-w2-core-churn.mjs",
    "check:w3-core-churn": "node tools/check-w3-core-churn.mjs",
    "check:w5-extraction": "node tools/check-w5-extraction.mjs",
    "check:w6-distribution": "node tools/check-w6-distribution.mjs",
    "package:distributions": "node tools/build-distributions.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:create-game && npm run build && npm run check:artifact && npm run package:distributions && npm run check:w6-distribution && npm run test:e2e",
    "hunt": "node tools/skeleton-hunt/index.mjs",
    "hunt:check": "node --check tools/skeleton-hunt/index.mjs",
    "create-game": "node tools/create-game.mjs",
    "test:create-game": "node tools/test-create-game.mjs",
    "check:w7-real-game": "node tools/check-w7-real-game.mjs",
    "check:w8-hero": "node tools/check-w8-hero.mjs",
    "test:w8-feel": "playwright test --config=playwright.w8.config.ts",
    "check:w8-sound": "node tools/check-w8-sound.mjs",
    "check:w8-3-polish": "node tools/check-w8-3-polish.mjs",
    "package:playtest": "node tools/build-w9-playtest.mjs",
    "check:w9-release": "node tools/check-w9-release.mjs",
    "test:w9-playtest": "playwright test --config=playwright.w9.config.mjs"
  },
  "dependencies": {
    "littlejsengine": "1.25.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
